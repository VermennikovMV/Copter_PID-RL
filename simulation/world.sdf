      <static>true</static>
      <pose>0 0 3 0 0 0</pose>
      <link name="marker">
        <visual name="marker">
          <geometry>
            <sphere>
              <radius>.095</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>.90 .32 .055 1</ambient>
            <diffuse>.90 .32 .055 1</diffuse>
          </material>
        </visual>
