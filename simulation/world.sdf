    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>Copter simulator</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre</engine>
        <scene>scene</scene>
        <ambient_light>.42 .42 .42</ambient_light>
        <background_color>.82 .86 .90</background_color>
        <camera_pose>1 -6 6 0 .55 1.5707963267948966</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager" />
      <plugin filename="InteractiveViewControl" name="Interactive view control" />
      <plugin filename="WorldControl" name="World control">
        <start_paused>false</start_paused>
        <service>/world/copter/control</service>
      </plugin>
      <plugin filename="WorldStats" name="World statistics" />
    </gui>
